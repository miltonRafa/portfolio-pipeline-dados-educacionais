        [IDEB Médio],
        REMOVEFILTERS(DIM_TEMPO[ANO]),
        DIM_TEMPO[ANO] = PrimeiroAno
    )
VAR ValorFinal =
    CALCULATE(
        [IDEB Médio],
        REMOVEFILTERS(DIM_TEMPO[ANO]),
        DIM_TEMPO[ANO] = UltimoAno
    )
RETURN
    IF(
        ISBLANK(PrimeiroAno)
            || ISBLANK(UltimoAno)
            || PrimeiroAno = UltimoAno,
        BLANK(),
        ValorFinal - ValorInicial
    )

