model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["gold","fnParquetGold","DIM_UF","DIM_TEMPO","DIM_ETAPA","DIM_AREA_PND","DIM_MUNICIPIO","FATO_RENDIMENTO","FATO_TDI","FATO_IDEB","FATO_SAEB","FATO_PND"]

annotation PBI_ProTooling = ["DevMode"]

ref table DIM_UF
ref table DIM_TEMPO
ref table DIM_ETAPA
ref table DIM_AREA_PND
ref table DIM_MUNICIPIO
ref table FATO_RENDIMENTO
ref table FATO_TDI
ref table FATO_IDEB
ref table FATO_SAEB
ref table FATO_PND
ref table _MEDIDAS

ref cultureInfo pt-BR

