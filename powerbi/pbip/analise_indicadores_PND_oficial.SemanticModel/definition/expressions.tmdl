expression gold =
		let
		    Fonte = Folder.Files("C:\portfolio-pipeline-dados-educacionais\data\gold")
		in
		    Fonte
	lineageTag: 863a251b-51e5-494d-a340-61b230bed413

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

expression fnParquetGold =
		(NomeArquivo as text) as table =>
		let
		    Arquivo = Table.SelectRows(
		        gold,
		        each [Name] = NomeArquivo
		    ),
		
		    ValidarArquivo =
		        if Table.RowCount(Arquivo) <> 1
		        then error "Arquivo Gold não encontrado ou duplicado: " & NomeArquivo
		        else Arquivo{0}[Content],
		
		    Dados = Parquet.Document(ValidarArquivo)
		in
		    Dados
	lineageTag: 3f270f93-bb4e-4bcf-bdd5-6d7a4053a872

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Function

